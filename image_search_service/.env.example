# Multiverse product image search — configuration
#
# Every value here is optional. With none of them set the service still runs
# and still finds images: Open Food Facts, Wikimedia and Openverse need no
# credentials. The keys below widen the search and let the service re-host
# images so product photos never hotlink someone else's server.

# --- Supabase: re-hosting found images -----------------------------------
# Re-hosting is strongly recommended. Without it a product is left pointing at
# a third-party URL (a Wikimedia file, a Pexels photo) that can be reorganised,
# rate-limited or deleted by its owner long after the product is listed.
# The anon key is enough while `global_products` is public-read.
SUPABASE_URL=https://ufvwjmtfbupnnpbivcxr.supabase.co
SUPABASE_ANON_KEY=
# Use the service-role key instead when the service runs outside a trusted
# network, or when the bucket stops being public-read.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=global_products

# --- Auth ----------------------------------------------------------------
# Off by default so the service can be run locally without Firebase. Turn it
# on in production: the dashboard sends a Firebase Auth ID token as a bearer
# token, and with this enabled the service verifies it and rejects anonymous
# traffic. Verification uses the Identity Toolkit REST API, which needs the
# project's web API key.
REQUIRE_AUTH=false
FIREBASE_API_KEY=

# --- Provider keys (optional) --------------------------------------------
# SerpAPI (Google Images) gives the closest matches for packaged goods, and is
# the single most effective key to add. Free tier available; 100 searches/month.
SERPAPI_KEY=
# Google Programmable Search (Custom Search JSON API) is an alternative to
# SerpAPI. Needs both a key and a search-engine id (cx) with image search on.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Openverse works anonymously but is capped at a few requests per hour; a token
# raises the limit.
OPENVERSE_TOKEN=

# --- Tuning --------------------------------------------------------------
# Anything scoring below this is never attached to a product automatically.
# Lower it to auto-fill more products, raise it to be stricter. 0.55 only
# accepts a photo the service is confident is the actual item.
MIN_ACCEPT_SCORE=0.55
# Comma separated, in priority order. Providers without credentials are
# skipped, so listing one that is unconfigured is harmless.
PROVIDER_ORDER=openfoodfacts,serpapi,google_cse,pexels,unsplash,wikimedia,openverse
# Set for local development only: the service identifies itself to Wikimedia
# and Openverse by this string, and both reject anonymous clients.
USER_AGENT=MultiverseProductImageBot/1.0 (https://multiverse.example; vendor-dashboard image lookup)

# --- Image quality -------------------------------------------------------
# An image is judged on its long edge, so a portrait pack shot counts: Open
# Food Facts' "400px" is a long-edge cap and a portrait product arrives as
# 213x400, which must not be thrown away.
MIN_EDGE_PX=220
# Floor on total pixels, so a sliver with one long edge is still refused.
MIN_IMAGE_PIXELS=50000
# Ceiling on how many pixels may be decoded. This is the real size limit, since
# it is what bounds decode memory; the output is capped at
# TARGET_MAX_EDGE_PX regardless of how large the source was.
MAX_DECODE_PIXELS=60000000
TARGET_MAX_EDGE_PX=1200

