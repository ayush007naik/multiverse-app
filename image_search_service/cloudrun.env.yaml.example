# Runtime configuration for the Cloud Run deployment of the product image
# search service. Copy to cloudrun.env.yaml, fill in the real values, and keep
# that copy out of git:
#
#   cp cloudrun.env.yaml.example cloudrun.env.yaml
#   ./image_search_service/deploy_cloudrun.sh
#
# Keep the .yaml suffix. gcloud chooses the parser from the file extension, so a
# name ending in .env is read as dotenv (KEY=VALUE) and this YAML parses to
# nothing.
#
# `gcloud run services update --set-env-vars` REPLACES the whole environment, so
# every variable the service needs has to be listed every time. Use
# --env-vars-file (which deploy_cloudrun.sh does) so a partial update can never
# silently drop REQUIRE_AUTH.

# --- Auth ---------------------------------------------------------------
# Leave true. /search, /resolve and /host are expensive and write to your
# Supabase bucket, so they must stay behind Firebase Auth ID tokens.
REQUIRE_AUTH: "true"
FIREBASE_PROJECT_ID: "multiverses-8d207"
# The client API key from vendor_dashboard/lib/firebase_options.dart. It is
# only used to call identitytoolkit accounts:lookup to validate a token.
FIREBASE_API_KEY: "AIzaSy..."

# --- Supabase (re-hosting, so product images never hotlink) -------------
SUPABASE_URL: "https://ufvwjmtfbupnnpbivcxr.supabase.co"
SUPABASE_STORAGE_BUCKET: "global_products"
# Service role key, because the bucket write needs to bypass RLS. Treat it as
# a secret: anyone holding it can write to the bucket.
SUPABASE_SERVICE_ROLE_KEY: "..."

# --- Misc ---------------------------------------------------------------
USER_AGENT: "MultiverseProductImageBot/1.0 (+https://multiverse.example; vendor-dashboard image lookup)"
CACHE_PATH: "/tmp/image-search-cache.sqlite3"
